FROM python:3.11-slim

# System deps
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    unzip \
    gnupg \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Terraform
RUN wget -O /tmp/terraform.zip https://releases.hashicorp.com/terraform/1.8.3/terraform_1.8.3_linux_amd64.zip \
    && unzip /tmp/terraform.zip -d /usr/local/bin/ \
    && rm /tmp/terraform.zip \
    && terraform --version

# Working dir
WORKDIR /app

# Install Python deps first (layer cache)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy app
COPY . .

# Create terraform workspace dir
RUN mkdir -p /tmp/cloudrizzle-terraform

# Non-root user
RUN adduser --disabled-password --gecos '' appuser \
    && chown -R appuser:appuser /app /tmp/cloudrizzle-terraform
USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
